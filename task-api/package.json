{
  "name": "task-api",
  "version": "1.0.0",
  "description": "API RESTful de Tarefas construída com Clean Architecture, Express e Sequelize",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": ["clean-architecture", "express", "sequelize", "sqlite"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "nodemon": "^3.1.4"
  }
}
